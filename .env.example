# Copiar a .env y rellenar. NUNCA commitear .env.

# --- Postgres (Neon vía Vercel) ---
# La integración de Vercel inyecta estas variables automáticamente en el deploy.
DATABASE_URL=

# --- Redis (Upstash) ---
# Estos son los nombres que inyecta el marketplace de Vercel. Con una cuenta directa de
# Upstash, la consola entrega UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN: el código
# acepta cualquiera de los dos pares.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Correo de los códigos de acceso (Resend) ---
# Sin estas dos, en desarrollo el código se imprime en la consola del servidor y en PRODUCCIÓN el
# ingreso falla a propósito: un código de acceso en los registros es una puerta abierta.
#
# RESEND_API_KEY: del panel de Resend, sección "API Keys".
# MAIL_FROM: la dirección desde la que salen. Su dominio tiene que estar verificado en Resend, o el
#            envío se rechaza con "domain is not verified".
RESEND_API_KEY=
MAIL_FROM=

# TEMPORAL — Desvío de todos los códigos a un solo buzón.
# Permite trabajar entre varias personas ANTES de tener un dominio de correo verificado: cada uno
# entra con SU dirección —su identidad, su sesión, su rastro— y lo único que se desvía es a qué buzón
# llega el mensaje. El asunto dice para quién es cada código.
#
# MIENTRAS ESTÉ PUESTA, quien pueda leer ese buzón puede entrar como CUALQUIER usuario de la
# plataforma. Hay que borrarla antes de que entre un cliente de verdad.
#
# Se revierte borrando esta línea. No hay nada más que deshacer.
MAIL_REDIRECT_TO=

# --- Sesión ---
# Firma de la cookie de sesión. Generar con: npm run gen:secret
SESSION_SECRET=

# --- Cifrado de credenciales SAP en reposo ---
# Clave de cifrado de las contraseñas de los usuarios de comunicación guardadas en
# Postgres. Generar con: npm run gen:secret
# Rotarla exige re-cifrar las credenciales existentes.
CREDENTIALS_ENCRYPTION_KEY=

# --- SSO: Microsoft (Entra ID) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- SSO: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URL pública de la app (callback de OAuth) ---
APP_BASE_URL=http://localhost:5173

# --- Asistente de IA ---
ANTHROPIC_API_KEY=

# --- Cron ---
# Protege el endpoint de tareas programadas. Generar con: npm run gen:secret
CRON_SECRET=

# --- Qué direcciones de SAP se permite llamar (defensa en profundidad sobre SSRF) ---
# Los tres valores son OPCIONALES: sin ellos se usan los patrones por defecto de
# core/transport/ssrf.js, que cubren los tenants estándar.
#
# Solo hay que rellenarlos si un cliente tiene un tenant con un nombre fuera de lo normal.
# Por defecto: tenants de IBP <algo>-api.scmibp<n>.ondemand.com; CI-DS en kyma.ondemand.com,
# hana.ondemand.com o hcs.cloud.sap.
ALLOWED_IBP_HOST_REGEX=
ALLOWED_CIDS_HOST_REGEX=
# Servicios de OData permitidos, separados por comas. Por defecto: MASTER_DATA_API_SRV,
# PLANNING_DATA_API_SRV y BC_EXT_APPJOB_MANAGEMENT.
ALLOWED_SAP_SERVICES=
